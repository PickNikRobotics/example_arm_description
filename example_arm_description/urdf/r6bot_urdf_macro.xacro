<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="r6bot_description" params="prefix:='' mirror:=false">

  <!--
    prefix: prepended to every link and joint name, so one robot description can contain more than one arm.
    mirror: reflect the arm across the y-z plane of its base frame, giving the mirror image of the default arm, for a
    pair of arms whose shoulders face opposite ways. The same joint values put a mirrored arm in the mirror-image pose,
    so every joint axis is reversed: a physical arm described this way needs a driver that reports its joints in that
    mirrored convention.
  -->
  <xacro:property name="mirror_sign" value="1"/>
  <xacro:property name="mirror_mesh_dir" value=""/>
  <xacro:if value="${mirror}">
    <xacro:property name="mirror_sign" value="-1"/>
    <!--
      Collision meshes come pre-mirrored, from scripts/generate_mirrored_collision_meshes.py: a negative mesh scale
      would turn them inside out, so collision padding would shrink them instead of growing them.
    -->
    <xacro:property name="mirror_mesh_dir" value="mirrored/"/>
  </xacro:if>

  <link name="${prefix}base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://example_arm_description/meshes/visual/link_0.dae" scale="${mirror_sign} 1 1"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://example_arm_description/meshes/collision/${mirror_mesh_dir}link_0.stl"/>
      </geometry>
    </collision>
  </link>

  <link name="${prefix}link_1">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://example_arm_description/meshes/visual/link_1.dae" scale="${mirror_sign} 1 1"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://example_arm_description/meshes/collision/${mirror_mesh_dir}link_1.stl"/>
      </geometry>
    </collision>
  </link>

  <link name="${prefix}link_2">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://example_arm_description/meshes/visual/link_2.dae" scale="${mirror_sign} 1 1"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://example_arm_description/meshes/collision/${mirror_mesh_dir}link_2.stl"/>
      </geometry>
    </collision>
  </link>

  <link name="${prefix}link_3">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://example_arm_description/meshes/visual/link_3.dae" scale="${mirror_sign} 1 1"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://example_arm_description/meshes/collision/${mirror_mesh_dir}link_3.stl"/>
      </geometry>
    </collision>
  </link>

  <link name="${prefix}link_4">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://example_arm_description/meshes/visual/link_4.dae" scale="${mirror_sign} 1 1"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://example_arm_description/meshes/collision/${mirror_mesh_dir}link_4.stl"/>
      </geometry>
    </collision>
  </link>

  <link name="${prefix}link_5">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://example_arm_description/meshes/visual/link_5.dae" scale="${mirror_sign} 1 1"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://example_arm_description/meshes/collision/${mirror_mesh_dir}link_5.stl"/>
      </geometry>
    </collision>
  </link>

  <link name="${prefix}link_6">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://example_arm_description/meshes/visual/link_6.dae" scale="${mirror_sign} 1 1"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://example_arm_description/meshes/collision/${mirror_mesh_dir}link_6.stl"/>
      </geometry>
    </collision>
  </link>

  <link name="${prefix}ft_frame"/>
  <link name="${prefix}tool0"/>

  <joint name="${prefix}joint_1" type="revolute">
    <parent link="${prefix}base_link"/>
    <child link="${prefix}link_1"/>
    <origin xyz="0 0 0.061584" rpy="0 0 0"/>
    <axis xyz="0 0 ${mirror_sign}"/>
    <limit effort="1000" lower="${-pi}" upper="${pi}" velocity="2.5"/>
  </joint>

  <joint name="${prefix}joint_2" type="revolute">
    <parent link="${prefix}link_1"/>
    <child link="${prefix}link_2"/>
    <origin xyz="${mirror_sign * -0.101717} 0 0.182284" rpy="${-pi/2} ${mirror_sign * -(pi/3)} ${mirror_sign * (pi/2)}"/>
    <axis xyz="0 0 ${mirror_sign}"/>
    <limit effort="1000" lower="${-pi}" upper="${pi}" velocity="2.5"/>
  </joint>

  <joint name="${prefix}joint_3" type="revolute">
    <parent link="${prefix}link_2"/>
    <child link="${prefix}link_3"/>
    <origin xyz="${mirror_sign * 0.685682} 0 0.041861" rpy="0 ${mirror_sign * (pi)} ${mirror_sign * (pi+pi/2)}"/>
    <axis xyz="0 0 ${mirror_sign}"/>
    <limit effort="1000" lower="${-pi}" upper="${pi}" velocity="2.5"/>
  </joint>

  <joint name="${prefix}joint_4" type="revolute">
    <parent link="${prefix}link_3"/>
    <child link="${prefix}link_4"/>
    <origin xyz="${mirror_sign * 0.518777} 0 0.067458" rpy="0 ${mirror_sign * (pi)} ${mirror_sign * (pi+pi/6)}"/>
    <axis xyz="0 0 ${mirror_sign}"/>
    <limit effort="1000" lower="${-pi}" upper="${pi}" velocity="2.5"/>
  </joint>

  <joint name="${prefix}joint_5" type="revolute">
    <parent link="${prefix}link_4"/>
    <child link="${prefix}link_5"/>
    <origin xyz="${mirror_sign * 0.112654} 0 0.110903" rpy="${pi/2} ${mirror_sign * (pi)} ${mirror_sign * (pi/2)}"/>
    <axis xyz="0 0 ${mirror_sign}"/>
    <limit effort="1000" lower="${-pi}" upper="${pi}" velocity="2.5"/>
  </joint>

  <joint name="${prefix}joint_6" type="revolute">
    <parent link="${prefix}link_5"/>
    <child link="${prefix}link_6"/>
    <origin xyz="${mirror_sign * -0.085976} 0 0.133436" rpy="0 ${mirror_sign * (-pi/2)} 0"/>
    <axis xyz="0 0 ${mirror_sign}"/>
    <limit effort="1000" lower="${-pi}" upper="${pi}" velocity="2.5"/>
  </joint>

  <joint name="${prefix}joint-ft_frame" type="fixed">
    <parent link="${prefix}link_6"/>
    <child link="${prefix}ft_frame"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <joint name="${prefix}joint-tool" type="fixed">
    <parent link="${prefix}ft_frame"/>
    <child link="${prefix}tool0"/>
    <origin xyz="0 0 0.185" rpy="0 0 0"/>
  </joint>

  </xacro:macro>
</robot>
